{
  "name": "n8n-nodes-square",
  "version": "1.0.0",
  "description": "Complete n8n community node for Square SMB payments and POS - 13 resources, 75+ operations for payments, orders, customers, catalog, inventory, invoices, subscriptions, loyalty, gift cards, team, and bookings",
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "square",
    "payments",
    "pos",
    "point-of-sale",
    "orders",
    "customers",
    "inventory",
    "invoices",
    "subscriptions",
    "loyalty",
    "gift-cards",
    "bookings",
    "catalog",
    "smb",
    "retail"
  ],
  "license": "BUSL-1.1",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-square",
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-square.git"
  },
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-square/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lint:fix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SquareApi.credentials.js",
      "dist/credentials/SquareOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Square/Square.node.js",
      "dist/nodes/Square/SquareTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.0.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
